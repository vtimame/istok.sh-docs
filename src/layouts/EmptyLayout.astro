---
import "@/styles/global.css";

import { isLocale, locales } from "@/i18n";
import { ui } from "@/i18n/ui";

interface Props {
  lang?: string;
  title?: string;
  description?: string;
  image?: string;
  alternates?: Partial<Record<string, string>>;
}

const { lang = "en", alternates = {} } = Astro.props;

// Link previews follow the page language.
const image = Astro.props.image ?? (lang === "ru" ? "/og-ru.png" : "/og.png");

const strings = ui[isLocale(lang) ? lang : "en"];
const title = Astro.props.title ?? strings.meta.title;
const description = Astro.props.description ?? strings.meta.description;

const site = Astro.site ?? new URL("https://istok.sh");

const canonicalUrl = new URL(Astro.url.pathname, site);
const imageUrl = new URL(image, site);
---

<html lang={lang}>
<head>
  <meta charset="utf-8" />

  <script is:inline>
    // Apply the saved or system theme before the first paint.
    (() => {
      let theme = null;
      try {
        theme = localStorage.getItem("theme");
      } catch {}

      const dark = theme ? theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", dark);
      document.documentElement.classList.add("js");
    })();
  </script>

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <link
    rel="icon"
    type="image/svg+xml"
    href="/favicon.svg"
  />

  <link
    rel="canonical"
    href={canonicalUrl}
  />

  {
    locales.map((locale) =>
      alternates[locale] ? (
        <link rel="alternate" hreflang={locale} href={new URL(alternates[locale]!, site)} />
      ) : null,
    )
  }

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    property="og:type"
    content="website"
  />

  <meta
    property="og:site_name"
    content="Istok"
  />

  <meta
    property="og:title"
    content={title}
  />

  <meta
    property="og:description"
    content={description}
  />

  <meta
    property="og:url"
    content={canonicalUrl}
  />

  <meta
    property="og:image"
    content={imageUrl}
  />

  <meta
    property="og:image:type"
    content="image/png"
  />

  <meta
    property="og:image:width"
    content="1200"
  />

  <meta
    property="og:image:height"
    content="630"
  />

  <meta
    property="og:image:alt"
    content={title}
  />

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={title}
  />

  <meta
    name="twitter:description"
    content={description}
  />

  <meta
    name="twitter:image"
    content={imageUrl}
  />
</head>

<body>
  <slot />
</body>
</html>