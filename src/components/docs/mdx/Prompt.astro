---
// What you say to your coding agent, shown as a chat bubble:
//
//   <Prompt>Register this project in Istok.</Prompt>
//
// An optional `reply` adds the agent's short answer below it.

interface Props {
  reply?: string;
}

const { reply } = Astro.props;
---

<div class="not-prose my-5 flex flex-col gap-2 text-sm leading-6">
  <p class="max-w-[85%] self-end rounded-2xl rounded-br-sm bg-primary px-4 py-2.5 text-primary-foreground">
    <slot />
  </p>

  {
    reply && (
      <p class="max-w-[85%] self-start rounded-2xl rounded-bl-sm border border-border bg-card px-4 py-2.5 text-foreground/85">
        {reply}
      </p>
    )
  }
</div>
