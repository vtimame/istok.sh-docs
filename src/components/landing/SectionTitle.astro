---
interface Props {
  lines: string[];
  size?: "md" | "lg";
  class?: string;
}

const { lines, size = "md", class: className } = Astro.props;
---

<div class={className}>
  <h2
    class:list={[
      "font-heading font-bold tracking-[-0.03em]",
      size === "lg"
        ? "text-4xl leading-[1.02] sm:text-5xl lg:text-6xl"
        : "text-3xl leading-[1.05] sm:text-4xl lg:text-5xl",
    ]}
  >
    {
      lines.map((line) => (
        <span class="block">{line}</span>
      ))
    }
  </h2>
</div>
