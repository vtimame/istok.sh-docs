---
import SectionTitle from "./SectionTitle.astro";

import { docsHref, type Locale } from "@/i18n";
import type { LandingStrings } from "@/i18n/landing";

interface Props {
  lang: Locale;
  strings: LandingStrings["start"];
}

const { lang, strings } = Astro.props;
---

<section class="border-t border-border/60 py-24 sm:py-28 lg:py-32">
  <div class="app-container">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <SectionTitle lines={strings.title} />

      <a
        href={docsHref(lang, "getting-started/quick-start")}
        class="text-sm font-medium text-muted-foreground underline decoration-border underline-offset-4 transition-colors hover:text-foreground"
      >
        {strings.more} →
      </a>
    </div>

    <ol class="mt-14 grid gap-5 md:grid-cols-2">
      {
        strings.steps.map((step, index) => (
          <li
            class="flex min-w-0 flex-col rounded-xl border border-border bg-card/60 p-6"
            data-reveal
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[11px] text-emerald-600 dark:text-emerald-500">0{index + 1}</span>
              <h3 class="font-medium tracking-tight">{step.title}</h3>
            </div>

            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.body}</p>

            {
              step.prompt ? (
                <p class="mt-5 self-start rounded-2xl rounded-bl-sm bg-primary px-4 py-2.5 text-sm text-primary-foreground">
                  {step.code}
                </p>
              ) : (
                <pre class="mt-5 overflow-x-auto rounded-lg bg-muted/70 px-4 py-3 font-mono text-[12.5px] leading-6 text-foreground/90"><code>{step.code}</code></pre>
              )
            }
          </li>
        ))
      }
    </ol>
  </div>
</section>
