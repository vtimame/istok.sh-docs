---
import { HeroOrbit } from "./HeroOrbit";
import { HeroText } from "./HeroText";

import { docsHref, type Locale } from "@/i18n";
import type { LandingStrings } from "@/i18n/landing";

interface Props {
  lang: Locale;
  strings: LandingStrings["hero"];
}

const { lang, strings } = Astro.props;
---

<section
  class="
    app-container relative isolate grid min-h-140 overflow-hidden pt-14
    sm:min-h-155
    lg:min-h-[calc(100dvh-3.5rem)] lg:grid-cols-[minmax(0,1fr)_minmax(400px,1fr)] lg:items-center lg:gap-8 lg:overflow-visible
    xl:grid-cols-2 xl:gap-12
  "
>
  <div class="relative z-20 flex items-center py-16 sm:px-6 sm:py-20 md:px-10 lg:px-0 lg:py-0">
    <HeroText
      client:load
      title={strings.title}
      subtitle={strings.subtitle}
      copyLabel={strings.copy}
      copiedLabel={strings.copied}
      docsLabel={strings.docs}
      docsHref={docsHref(lang, "getting-started/introduction")}
    />
  </div>

  <div
    class="
      pointer-events-none absolute -top-[220px] -right-[380px] z-0 w-[760px] opacity-40
      sm:-top-[270px] sm:-right-[360px] sm:w-[880px] sm:opacity-50
      md:-top-[300px] md:-right-[300px] md:w-[960px] md:opacity-60
      lg:pointer-events-auto lg:relative lg:top-auto lg:right-auto lg:z-10 lg:w-full lg:max-w-[450px] lg:justify-self-end lg:opacity-100
      xl:max-w-[500px]
      2xl:max-w-[560px]
    "
  >
    <HeroOrbit client:load size={960} />
  </div>
</section>
