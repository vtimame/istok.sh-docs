---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  url?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const {
  light,
  dark,
  alt,
  url = "127.0.0.1:7700",
  sizes = "(min-width: 1280px) 760px, (min-width: 1024px) 60vw, 100vw",
  eager = false,
  class: className,
} = Astro.props;

const widths = [800, 1200, 1600, 2000, light.width];
const loading = eager ? "eager" : "lazy";
---

<figure
  class:list={[
    "overflow-hidden rounded-xl border border-border bg-card shadow-2xl shadow-black/10 dark:shadow-black/40",
    className,
  ]}
>
  <div class="relative flex h-8 items-center border-b border-border/70 px-3 sm:h-9">
    <div class="flex gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-foreground/15"></span>
      <span class="size-2.5 rounded-full bg-foreground/15"></span>
      <span class="size-2.5 rounded-full bg-foreground/15"></span>
    </div>

    <div
      class="absolute left-1/2 hidden -translate-x-1/2 rounded-md bg-muted/70 px-3 py-0.5 font-mono text-[11px] text-muted-foreground sm:block"
    >
      {url}
    </div>
  </div>

  <Image
    src={light}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    class="block h-auto w-full dark:hidden"
  />

  <Image
    src={dark}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    class="hidden h-auto w-full dark:block"
  />
</figure>
