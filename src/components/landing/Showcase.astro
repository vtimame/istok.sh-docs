---
import BrowserFrame from "./BrowserFrame.astro";
import SectionTitle from "./SectionTitle.astro";
import TerminalFrame from "./TerminalFrame.astro";

import type { LandingStrings } from "@/i18n/landing";

import projectsLight from "@/assets/screenshots/projects-light.webp";
import projectsDark from "@/assets/screenshots/projects-dark.webp";
import runsLight from "@/assets/screenshots/runs-light.webp";
import runsDark from "@/assets/screenshots/runs-dark.webp";
import tasksLight from "@/assets/screenshots/tasks-light.webp";
import tasksDark from "@/assets/screenshots/tasks-dark.webp";

import projectsTerminal from "@/assets/terminal/projects.ansi?raw";
import runsTerminal from "@/assets/terminal/runs.ansi?raw";
import tasksTerminal from "@/assets/terminal/tasks.ansi?raw";

interface Props {
  strings: LandingStrings["showcase"];
}

const { strings } = Astro.props;

// Every view exists twice: as the web UI and as the same data in the CLI.
const views = [
  {
    id: "projects",
    light: projectsLight,
    dark: projectsDark,
    url: "127.0.0.1:7700",
    terminal: projectsTerminal,
    cwd: "~/work",
  },
  {
    id: "runs",
    light: runsLight,
    dark: runsDark,
    url: "127.0.0.1:7700/runs",
    terminal: runsTerminal,
    cwd: "~/work/acme-api",
  },
  {
    id: "tasks",
    light: tasksLight,
    dark: tasksDark,
    url: "127.0.0.1:7700/projects/acme-api",
    terminal: tasksTerminal,
    cwd: "~/work/acme-api",
  },
] as const;

const media = ["browser", "terminal"] as const;

const segment =
  "rounded-md px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground aria-selected:bg-background aria-selected:text-foreground aria-selected:shadow-sm aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-sm";
---

<section class="border-t border-border/60 py-24 sm:py-28 lg:py-32">
  <div class="app-container">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <SectionTitle lines={strings.title} />

      <p class="mx-auto mt-7 max-w-xl leading-relaxed text-muted-foreground">{strings.body}</p>
    </div>

    <div class="mx-auto mt-12 max-w-6xl" data-showcase data-medium="browser" data-reveal>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div role="tablist" aria-label={strings.title.join(" ")} class="flex gap-1 rounded-lg bg-muted p-1">
          {
            views.map((view, index) => (
              <button
                type="button"
                role="tab"
                id={`showcase-tab-${view.id}`}
                aria-controls={`showcase-panel-${view.id}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
                class={segment}
              >
                {strings.tabs[view.id]}
              </button>
            ))
          }
        </div>

        <div role="group" aria-label={strings.mediaLabel} class="flex gap-1 rounded-lg bg-muted p-1">
          {
            media.map((medium, index) => (
              <button
                type="button"
                data-medium-button={medium}
                aria-pressed={index === 0 ? "true" : "false"}
                class={segment}
              >
                {strings.media[medium]}
              </button>
            ))
          }
        </div>
      </div>

      <div class="mt-6 grid">
        {
          views.map((view, index) => (
            <div
              role="tabpanel"
              id={`showcase-panel-${view.id}`}
              aria-labelledby={`showcase-tab-${view.id}`}
              data-active={index === 0 ? "true" : "false"}
              class="grid [grid-area:1/1] transition-opacity duration-500 data-[active=false]:pointer-events-none data-[active=false]:invisible data-[active=false]:opacity-0"
            >
              <div data-medium-view="browser" class="[grid-area:1/1] transition-opacity duration-300">
                <BrowserFrame
                  light={view.light}
                  dark={view.dark}
                  alt={strings.alt[view.id]}
                  url={view.url}
                  sizes="(min-width: 1200px) 1152px, 100vw"
                  eager={index === 0}
                />
              </div>

              <div data-medium-view="terminal" class="[grid-area:1/1] transition-opacity duration-300">
                <TerminalFrame ansi={view.terminal} title={view.cwd} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* The medium switch shows either the web UI or the CLI inside every panel. */
  [data-showcase][data-medium="browser"] [data-medium-view="terminal"],
  [data-showcase][data-medium="terminal"] [data-medium-view="browser"] {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  for (const showcase of document.querySelectorAll<HTMLElement>("[data-showcase]")) {
    const tabs = [...showcase.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const mediumButtons = [...showcase.querySelectorAll<HTMLButtonElement>("[data-medium-button]")];

    const select = (tab: HTMLButtonElement) => {
      for (const other of tabs) {
        const active = other === tab;
        other.setAttribute("aria-selected", String(active));
        other.tabIndex = active ? 0 : -1;

        const panel = document.getElementById(other.getAttribute("aria-controls")!);
        panel?.setAttribute("data-active", String(active));
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab));

      // Arrow keys move between tabs, as in the WAI-ARIA tabs pattern.
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (step === 0) {
          return;
        }

        const next = tabs[(index + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });

    for (const button of mediumButtons) {
      button.addEventListener("click", () => {
        showcase.dataset.medium = button.dataset.mediumButton;

        for (const other of mediumButtons) {
          other.setAttribute("aria-pressed", String(other === button));
        }
      });
    }
  }
</script>
