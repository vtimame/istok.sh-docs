---
import SectionTitle from "./SectionTitle.astro";

import type { LandingStrings } from "@/i18n/landing";

interface Props {
  strings: LandingStrings["problem"];
}

const { strings } = Astro.props;
---

<section class="border-t border-border/60 py-24 sm:py-28 lg:py-32">
  <div class="app-container">
    <div data-reveal>
      <SectionTitle lines={strings.title} eyebrow={strings.eyebrow} />
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-xl border border-border bg-border md:grid-cols-3">
      {
        strings.items.map((item, index) => (
          <div class="bg-background p-7 sm:p-8" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
            <div class="font-mono text-[11px] text-muted-foreground/70">0{index + 1}</div>
            <h3 class="mt-4 text-lg font-medium tracking-tight">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
