---
import SectionTitle from "./SectionTitle.astro";

import { buttonVariants } from "@/components/ui/button";
import { docsHref, type Locale } from "@/i18n";
import type { LandingStrings } from "@/i18n/landing";

interface Props {
  lang: Locale;
  strings: LandingStrings["cta"];
}

const { lang, strings } = Astro.props;
---

<section class="border-t border-border/60 py-24 sm:py-28 lg:py-36">
  <div class="app-container">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between" data-reveal>
      <div class="max-w-3xl">
        <SectionTitle lines={strings.title} eyebrow={strings.eyebrow} size="lg" />

        <p class="mt-7 max-w-xl leading-relaxed text-muted-foreground">{strings.body}</p>
      </div>

      <a href={docsHref(lang, "getting-started/quick-start")} class={buttonVariants({ size: "lg" })}>
        {strings.button}
      </a>
    </div>
  </div>
</section>
