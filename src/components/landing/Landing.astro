---
import Header from "@/components/layout/Header";
import EmptyLayout from "@/layouts/EmptyLayout.astro";

import { HeroText } from "./HeroText";

import { docsHref, homeHref, locales, type Locale } from "@/i18n";
import { landing } from "@/i18n/landing";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const strings = landing[lang];

const repository = "https://github.com/vtimame/istok.sh";
const alternates = Object.fromEntries(locales.map((locale) => [locale, homeHref(locale)]));
const alternateHref = homeHref(lang === "en" ? "ru" : "en");
---

<EmptyLayout lang={lang} alternates={alternates}>
  <Header client:load lang={lang} alternateHref={alternateHref} />

  <main class="app-container flex min-h-[calc(100dvh-3.5rem)] flex-col justify-center gap-12 pt-14 pb-10">
    <div class="max-w-2xl">
      <HeroText
        client:load
        title={strings.title}
        highlight={strings.highlight}
        subtitle={strings.subtitle}
        copyLabel={strings.copy}
        copiedLabel={strings.copied}
        docsLabel={strings.docs}
        docsHref={docsHref(lang, "getting-started/introduction")}
      />
    </div>

    <ul class="grid max-w-4xl gap-6 sm:grid-cols-3">
      {
        strings.points.map((point) => (
          <li>
            <p class="font-semibold">{point.title}</p>
            <p class="mt-1 text-sm leading-6 text-muted-foreground">{point.body}</p>
          </li>
        ))
      }
    </ul>

    <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted-foreground">
      <a class="hover:text-foreground" href={docsHref(lang, "getting-started/introduction")}>{strings.links.docs}</a>
      <a class="hover:text-foreground" href={repository}>GitHub</a>
      <a class="hover:text-foreground" href={`${repository}/blob/main/CHANGELOG.md`}>{strings.links.changelog}</a>
      <a class="hover:text-foreground" href={`${repository}/blob/main/LICENSE`}>Apache-2.0</a>
    </nav>
  </main>
</EmptyLayout>
