---
// A scratch page for the black hole divider. Not linked from the site.
import Header from "@/components/layout/Header";
import EmptyLayout from "@/layouts/EmptyLayout.astro";
import { BlackHoleDivider } from "@/components/landing/BlackHoleDivider";
---

<EmptyLayout title="Divider lab — Istok">
  <Header client:load lang="en" />

  <main class="pt-14">
    <section class="app-container flex h-[420px] items-center">
      <h1 class="font-heading text-5xl font-bold tracking-[-0.035em]">Hero above the divider.</h1>
    </section>

    <BlackHoleDivider client:only="react" />

    <section class="app-container py-24">
      <h2 class="font-heading text-4xl font-bold tracking-[-0.03em]">The page continues below.</h2>
      <p class="mt-6 max-w-xl text-muted-foreground">
        The disc line separates the hero from the content; the lower half of the black hole stays hidden behind it.
      </p>
    </section>
  </main>
</EmptyLayout>
