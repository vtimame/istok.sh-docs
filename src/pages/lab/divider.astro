---
// A scratch page for the gravity well hero visual. Not linked from the site.
import Header from "@/components/layout/Header";
import { Footer } from "@/components/layout/Footer";
import EmptyLayout from "@/layouts/EmptyLayout.astro";
import Hero from "@/components/landing/Hero.astro";
import { GravityWell } from "@/components/landing/blackhole/GravityWell";
import { landing } from "@/i18n/landing";
---

<EmptyLayout lang="ru" title="Hero lab — Istok">
  <Header client:load lang="ru" />

  <main>
    <Hero lang="ru" strings={landing.ru.hero}>
      <div slot="visual" class="mx-auto aspect-square w-full max-w-[640px]">
        <GravityWell client:only="react" />
      </div>
    </Hero>
  </main>

  <Footer lang="ru" />
</EmptyLayout>
